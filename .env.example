# Your ElevenLabs Conversational AI Agent ID (starts with "agent_")
# Find it at: https://elevenlabs.io/app/agents → select your agent → copy Agent ID
# NOTE: This is NOT your API key (sk_...) — it's the agent-specific ID
VITE_ELEVENLABS_AGENT_ID=agent_your_agent_id_here

# Your ElevenLabs API key (starts with "sk_")
# Required for Electron mode (signed URL auth)
# Find it at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_your_api_key_here
