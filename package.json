{
  "name": "aura",
  "version": "1.0.0",
  "description": "Voice-first macOS desktop commander powered by ElevenLabs Conversational AI",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run build:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "electron:build": "npm run build && electron-builder",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@elevenlabs/react": "^1.4.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.aura.desktop",
    "productName": "Aura",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "entitlements": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Aura needs microphone access for voice commands",
        "NSAppleEventsUsageDescription": "Aura needs automation access to control your Mac"
      }
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
